<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr3_r540_ros2_control">
  <xacro:macro name="kr3_r540_interface" params="name prefix rsi_ip rsi_port connection_timeout communication_timeout has_ft_sensor">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>aica_kuka_kr_interface/RsiInterface</plugin>
        <param name="rsi_ip">${rsi_ip}</param>
        <param name="rsi_port">${rsi_port}</param>
        <param name="connection_timeout">${connection_timeout}</param>
        <param name="communication_timeout">${communication_timeout}</param>
      </hardware>

      <joint name="${prefix}joint_a1">
        <command_interface name="position">
          <param name="min">${radians(-170)}</param>
          <param name="max">${radians(170)}</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">${radians(-530)}</param>
          <param name="max">${radians(530)}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}joint_a2">
        <command_interface name="position">
          <param name="min">${radians(-170)}</param>
          <param name="max">${radians(50)}</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">${radians(-529)}</param>
          <param name="max">${radians(529)}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}joint_a3">
        <command_interface name="position">
          <param name="min">${radians(-110)}</param>
          <param name="max">${radians(155)}</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">${radians(-538)}</param>
          <param name="max">${radians(538)}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}joint_a4">
        <command_interface name="position">
          <param name="min">${radians(-175)}</param>
          <param name="max">${radians(175)}</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">${radians(-600)}</param>
          <param name="max">${radians(600)}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}joint_a5">
        <command_interface name="position">
          <param name="min">${radians(-120)}</param>
          <param name="max">${radians(120)}</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">${radians(-600)}</param>
          <param name="max">${radians(600)}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}joint_a6">
        <command_interface name="position">
          <param name="min">${radians(-350)}</param>
          <param name="max">${radians(350)}</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">${radians(-800)}</param>
          <param name="max">${radians(800)}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <xacro:if value="${has_ft_sensor}">
        <sensor name="${prefix}ft_sensor">
          <state_interface name="force.x"/>
          <state_interface name="force.y"/>
          <state_interface name="force.z"/>
          <state_interface name="torque.x"/>
          <state_interface name="torque.y"/>
          <state_interface name="torque.z"/>
        </sensor>
      </xacro:if>

    </ros2_control>
  </xacro:macro>
</robot>